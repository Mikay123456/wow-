        }

        .emoji {
            font-size: 70px;
        }

        h1 {
            color: #ff4d6d;
            font-size: 28px;
        }

        p {
            font-size: 19px;
            line-height: 1.5;
        }

        .highlight {
            font-weight: bold;
            color: #ff1744;
            font-size: 22px;
        }

        button {
            margin-top: 15px;
            padding: 12px 25px;
            border: none;
            border-radius: 20px;
            background: #ff4d6d;
            color: white;
            font-size: 16px;
            cursor: pointer;
        }

        button:hover {
            background: #ff1744;
        }

        #message {
            margin-top: 20px;
            font-weight: bold;
            color: #555;
        }
    </style>
</head>

<body>

    <div class="card">

